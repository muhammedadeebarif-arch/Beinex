# Application Port
SERVER_PORT=8080

# CORS Allowed Origin (Default is Angular Dev Server)
CORS_ALLOWED_ORIGIN=http://localhost:4200

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=employee_db
DB_SSLMODE=disable

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINS=15

# Static Files Directory (Angular compiled build)
# Defaults automatically to ../frontend/dist/frontend/browser
# STATIC_DIR=../frontend/dist/frontend/browser
